{
  "name": "juno",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "node scripts/format-repository.mjs --write",
    "format:check": "node scripts/format-repository.mjs",
    "review:start": "node scripts/review/cli.mjs start",
    "review:status": "node scripts/review/cli.mjs status",
    "review:test": "node scripts/review/cli.mjs test",
    "review:credentials": "node scripts/review/cli.mjs credentials",
    "review:directory": "node scripts/review/cli.mjs directory",
    "review:stop": "node scripts/review/cli.mjs stop"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "ajv": "6.15.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
